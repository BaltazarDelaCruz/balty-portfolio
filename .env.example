# Admin Panel Password
# Change this to a strong password for production!
VITE_ADMIN_PASSWORD=your_secure_password_here

# Sanity Write Token (Required for adding/editing content in admin panel)
# Get this from: https://www.sanity.io/manage/personal/project/7bkfx0pl/api#tokens
# Create a token with "Editor" permissions
VITE_SANITY_TOKEN=your_sanity_write_token_here

# Sanity Configuration (already in code, but you can override here)
# VITE_SANITY_PROJECT_ID=7bkfx0pl
# VITE_SANITY_DATASET=production
